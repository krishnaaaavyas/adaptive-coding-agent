# Future host must load this exact hash and attest application; never loaded in0R.
#include <tunables/global>
profile qwen30-worker-v1 flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>
  /opt/python3.11.9/bin/python3.11 ix,
  /opt/** r,
  /opt/**.so* mr,
  /usr/** r,
  /usr/**.so* mr,
  /lib/** mr,
  /etc/** r,
  /proc/** r,
  /sys/** r,
  /dev/null rw,
  /dev/urandom r,
  /dev/random r,
  /dev/nvidia* rw,
  /dev/nvidia-caps/** rw,
  /models/original/** r,
  /inputs/** r,
  /outputs/** rwk,
  /scratch/** rwk,
  /tmp/** rwk,
  /dev/shm/** rwk,
  network unix,
  deny network inet,
  deny network inet6,
  deny /var/run/docker.sock rw,
  deny /run/ssh* rw,
  deny /root/** rwklx,
  deny /home/** rwklx,
  deny /bin/** x,
  deny /usr/bin/** x,
  deny /models/original/** wklx,
  deny /inputs/** wklx,
  signal (receive) peer=unconfined,
  signal (send,receive) peer=qwen30-worker-v1,
}
