{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:qwen30:external-run:v1",
  "title": "Qwen30 immutable executable run receipt",
  "description": "Future external runs only; this step emits no executable run manifests. Null is incomplete, never fabricated zero. Validate with semantic_receipt_rules.json in addition to JSON Schema.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "timestamp",
    "run_kind",
    "checkpoint_repo",
    "checkpoint_SHA",
    "checkpoint_body_hashes",
    "container_digest",
    "runtime_identities",
    "GPU",
    "driver",
    "CUDA",
    "frozen_control_values",
    "effective_control_receipt_sha256",
    "prompt_fixture_id",
    "prompt_fixture_sha256",
    "exact_prompt_token_ids",
    "exact_prompt_token_count",
    "raw_generated_token_ids",
    "raw_generated_bytes_sha256",
    "raw_generated_bytes_artifact",
    "raw_byte_length",
    "generated_token_count",
    "finish_reason",
    "stop_reason",
    "terminal_token",
    "terminal_removal_receipt",
    "normalized_completion_sha256",
    "wall_time",
    "TTFT",
    "throughput",
    "peak_VRAM",
    "peak_host_RAM",
    "resource_telemetry_sha256",
    "isolation_result",
    "isolation_receipt_sha256",
    "gate_id",
    "gate_result",
    "failure_classification",
    "failure_id",
    "prerequisite_run_ids",
    "provenance_artifact_hashes",
    "invocation_count",
    "retry_count",
    "parent_original_SHA",
    "adapter_identity_sha256",
    "derivative_identity_sha256",
    "freshness_receipt_sha256",
    "notes"
  ],
  "properties": {
    "schema_version": {
      "const": "qwen30-external-run-v1"
    },
    "run_id": {
      "type": "string",
      "pattern": "^qwen30-[A-Za-z0-9_.-]+$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "run_kind": {
      "enum": [
        "identity",
        "isolation",
        "load",
        "generation",
        "lifecycle",
        "resource",
        "timing",
        "reset"
      ]
    },
    "checkpoint_repo": {
      "const": "Qwen/Qwen3-Coder-30B-A3B-Instruct"
    },
    "checkpoint_SHA": {
      "const": "b2cff646eb4bb1d68355c01b18ae02e7cf42d120"
    },
    "checkpoint_body_hashes": {
      "anyOf": [
        {
          "type": "array",
          "minItems": 16,
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "bytes",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "bytes": {
                "type": "integer",
                "minimum": 0
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "container_digest": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "runtime_identities": {
      "anyOf": [
        {
          "type": "object",
          "required": [
            "runtime_lock_sha256",
            "package_lock_sha256",
            "python",
            "vllm",
            "transformers",
            "peft",
            "tokenizers",
            "jinja2",
            "torch_build",
            "kernel_inventory_sha256",
            "parser_build_sha256",
            "runner_build_sha256"
          ],
          "properties": {
            "runtime_lock_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "package_lock_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "python": {
              "const": "CPython3.11.9/Unicode14.0.0"
            },
            "vllm": {
              "const": "0.11.2"
            },
            "transformers": {
              "const": "4.57.6"
            },
            "peft": {
              "const": "0.18.0"
            },
            "tokenizers": {
              "const": "0.22.2"
            },
            "jinja2": {
              "const": "3.1.6"
            },
            "torch_build": {
              "const": "2.9.0+cu128"
            },
            "kernel_inventory_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "parser_build_sha256": {
              "const": "2ecd8d12df578abf03668271c39d3f3964d4a08d13e19cc2c8817f9bc0e1737a"
            },
            "runner_build_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "additionalProperties": true
        },
        {
          "type": "null"
        }
      ]
    },
    "GPU": {
      "anyOf": [
        {
          "type": "object",
          "required": [
            "model",
            "count",
            "UUIDs",
            "topology_sha256",
            "compute_capability"
          ],
          "properties": {
            "model": {
              "type": "string",
              "minLength": 1
            },
            "count": {
              "const": 1
            },
            "UUIDs": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "topology_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "compute_capability": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "driver": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "CUDA": {
      "anyOf": [
        {
          "type": "object",
          "required": [
            "toolkit",
            "torch_cuda",
            "loaded_libraries_sha256"
          ],
          "properties": {
            "toolkit": {
              "const": "12.8.1"
            },
            "torch_cuda": {
              "const": "12.8"
            },
            "loaded_libraries_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "additionalProperties": true
        },
        {
          "type": "null"
        }
      ]
    },
    "frozen_control_values": {
      "const": {
        "decoding": "greedy",
        "temperature": 0,
        "top_p": 1,
        "top_k": "disabled",
        "repetition_penalty": 1,
        "frequency_penalty": 0,
        "presence_penalty": 0,
        "seed": 0,
        "text_stops": [],
        "max_generation": 2048,
        "completions": 1,
        "retries": 0,
        "context_shifting": false,
        "clipping": false,
        "truncation": false
      }
    },
    "effective_control_receipt_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "prompt_fixture_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "prompt_fixture_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "exact_prompt_token_ids": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "exact_prompt_token_count": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "raw_generated_token_ids": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "maxItems": 2048
        },
        {
          "type": "null"
        }
      ]
    },
    "raw_generated_bytes_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "raw_generated_bytes_artifact": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "bytes",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "bytes": {
              "type": "integer",
              "minimum": 0
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "raw_byte_length": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "generated_token_count": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 2048
        },
        {
          "type": "null"
        }
      ]
    },
    "finish_reason": {
      "anyOf": [
        {
          "enum": [
            "STOP",
            "LENGTH",
            "ERROR",
            "UNKNOWN"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "stop_reason": {
      "anyOf": [
        {
          "type": [
            "integer",
            "string"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "terminal_token": {
      "enum": [
        null,
        151645,
        151643
      ]
    },
    "terminal_removal_receipt": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "observed_final_native_terminal",
            "removed_token_ids",
            "removed_count",
            "evidence_sha256",
            "justification"
          ],
          "properties": {
            "observed_final_native_terminal": {
              "type": "boolean"
            },
            "removed_token_ids": {
              "type": "array",
              "maxItems": 1,
              "items": {
                "enum": [
                  151645,
                  151643
                ]
              }
            },
            "removed_count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1
            },
            "evidence_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "justification": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "normalized_completion_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "wall_time": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "TTFT": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "throughput": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "peak_VRAM": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "peak_host_RAM": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "resource_telemetry_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "isolation_result": {
      "enum": [
        "PASS",
        "FAIL",
        "PENDING",
        "NOT_RUN"
      ]
    },
    "isolation_receipt_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "gate_id": {
      "enum": [
        "A",
        "B",
        "C",
        "D",
        "E",
        "F",
        "G",
        "H",
        "I",
        "J",
        "K",
        "L",
        "M",
        "N",
        "O",
        "P",
        "Q",
        "R",
        "S"
      ]
    },
    "gate_result": {
      "enum": [
        "PASS",
        "FAIL",
        "PENDING",
        "QUARANTINED",
        "STOPPED",
        "INVALIDATED"
      ]
    },
    "failure_classification": {
      "enum": [
        null,
        "A",
        "B",
        "C"
      ]
    },
    "failure_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "prerequisite_run_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "provenance_artifact_hashes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "bytes",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "invocation_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1
    },
    "retry_count": {
      "const": 0
    },
    "parent_original_SHA": {
      "const": "b2cff646eb4bb1d68355c01b18ae02e7cf42d120"
    },
    "adapter_identity_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "derivative_identity_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "freshness_receipt_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "gate_result": {
            "const": "PASS"
          }
        }
      },
      "then": {
        "properties": {
          "container_digest": {
            "not": {
              "type": "null"
            }
          },
          "runtime_identities": {
            "not": {
              "type": "null"
            }
          },
          "GPU": {
            "not": {
              "type": "null"
            }
          },
          "driver": {
            "not": {
              "type": "null"
            }
          },
          "CUDA": {
            "not": {
              "type": "null"
            }
          },
          "failure_classification": {
            "type": "null"
          },
          "failure_id": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "gate_result": {
            "const": "PASS"
          },
          "gate_id": {
            "not": {
              "enum": [
                "A",
                "B"
              ]
            }
          }
        }
      },
      "then": {
        "properties": {
          "isolation_receipt_sha256": {
            "not": {
              "type": "null"
            }
          },
          "isolation_result": {
            "const": "PASS"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "gate_result": {
            "enum": [
              "FAIL",
              "PENDING",
              "QUARANTINED",
              "STOPPED"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "failure_classification": {
            "enum": [
              "A",
              "B",
              "C"
            ]
          },
          "failure_id": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "run_kind": {
            "const": "generation"
          },
          "gate_result": {
            "const": "PASS"
          }
        }
      },
      "then": {
        "properties": {
          "effective_control_receipt_sha256": {
            "not": {
              "type": "null"
            }
          },
          "prompt_fixture_id": {
            "not": {
              "type": "null"
            }
          },
          "prompt_fixture_sha256": {
            "not": {
              "type": "null"
            }
          },
          "exact_prompt_token_ids": {
            "not": {
              "type": "null"
            }
          },
          "exact_prompt_token_count": {
            "maximum": 30720
          },
          "raw_generated_token_ids": {
            "not": {
              "type": "null"
            }
          },
          "raw_generated_bytes_sha256": {
            "not": {
              "type": "null"
            }
          },
          "raw_generated_bytes_artifact": {
            "not": {
              "type": "null"
            }
          },
          "raw_byte_length": {
            "not": {
              "type": "null"
            }
          },
          "generated_token_count": {
            "not": {
              "type": "null"
            }
          },
          "finish_reason": {
            "enum": [
              "STOP",
              "LENGTH"
            ]
          },
          "terminal_removal_receipt": {
            "not": {
              "type": "null"
            }
          },
          "normalized_completion_sha256": {
            "not": {
              "type": "null"
            }
          },
          "resource_telemetry_sha256": {
            "not": {
              "type": "null"
            }
          },
          "wall_time": {
            "not": {
              "type": "null"
            }
          },
          "TTFT": {
            "not": {
              "type": "null"
            }
          },
          "peak_VRAM": {
            "not": {
              "type": "null"
            }
          },
          "peak_host_RAM": {
            "not": {
              "type": "null"
            }
          },
          "invocation_count": {
            "const": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "gate_id": {
            "const": "H"
          },
          "gate_result": {
            "const": "PASS"
          }
        }
      },
      "then": {
        "properties": {
          "run_kind": {
            "const": "generation"
          },
          "finish_reason": {
            "const": "LENGTH"
          },
          "generated_token_count": {
            "const": 2048
          },
          "raw_generated_token_ids": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            },
            "minItems": 2048,
            "maxItems": 2048
          },
          "terminal_token": {
            "type": "null"
          },
          "terminal_removal_receipt": {
            "properties": {
              "removed_count": {
                "const": 0
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "run_kind": {
            "enum": [
              "load",
              "generation",
              "lifecycle",
              "resource",
              "timing"
            ]
          },
          "gate_result": {
            "const": "PASS"
          }
        }
      },
      "then": {
        "properties": {
          "checkpoint_body_hashes": {
            "not": {
              "type": "null"
            }
          },
          "wall_time": {
            "not": {
              "type": "null"
            }
          },
          "peak_VRAM": {
            "not": {
              "type": "null"
            }
          },
          "peak_host_RAM": {
            "not": {
              "type": "null"
            }
          },
          "resource_telemetry_sha256": {
            "not": {
              "type": "null"
            }
          }
        }
      }
    }
  ]
}
