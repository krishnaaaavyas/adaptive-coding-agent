{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "created_at_utc": {
      "format": "date-time",
      "type": "string"
    },
    "normalization_procedure_version": {
      "const": "1"
    },
    "normalization_schema_version": {
      "const": "1"
    },
    "normalized_artifact": {
      "minLength": 1,
      "type": "string"
    },
    "normalized_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "omissions": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "rule_category": {
            "enum": [
              "ranking",
              "recommendation",
              "evidence-role",
              "experimental-usefulness",
              "model-speculation",
              "editorial-prioritization"
            ]
          },
          "source_location": {
            "type": "string"
          }
        },
        "required": [
          "source_location",
          "rule_category"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "raw_artifact": {
      "minLength": 1,
      "type": "string"
    },
    "raw_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "status": {
      "enum": [
        "draft",
        "frozen"
      ]
    }
  },
  "required": [
    "raw_artifact",
    "raw_sha256",
    "normalized_artifact",
    "normalized_sha256",
    "normalization_schema_version",
    "normalization_procedure_version",
    "created_at_utc",
    "status",
    "omissions"
  ],
  "type": "object"
}
